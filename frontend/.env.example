# Copie para frontend/.env.local e ajuste se precisar.
# O .env.local esta no .gitignore — nao commitar.

# URL do backend Flask. Porta padrao definida em backend/wsgi.py.
#
# 127.0.0.1 em vez de localhost: no macOS a porta 5000 tambem e usada
# pelo AirPlay Receiver (Central de Controle > AirPlay Receiver), que
# responde no IPv6 (::1) antes do Flask se "localhost" resolver pra la
# primeiro — a requisicao cai no AirPlay em vez da API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
