# Copie para backend/.env e ajuste se precisar.
# O .env esta no .gitignore da raiz — nao commitar.

# Bate com o docker-compose.yml da raiz do repositorio:
# banco bookshelf, usuario bookshelf, senha bookshelf, porta 3306.
DATABASE_URL=mysql+pymysql://bookshelf:bookshelf@127.0.0.1:3306/bookshelf?charset=utf8mb4

FLASK_APP=wsgi.py
FLASK_DEBUG=1

# Assina a sessao do Flask E o token JWT do login.
#
# Use pelo menos 32 caracteres: abaixo disso o PyJWT avisa que a chave e
# curta demais para o algoritmo HS256. Gere a sua com
#     python -c "import secrets; print(secrets.token_hex(32))"
# Trocar esta chave invalida todos os tokens ja emitidos — quem estava
# logado precisa entrar de novo.
SECRET_KEY=troque-isso-por-uma-chave-longa-de-desenvolvimento

# Quem pode chamar a API pelo navegador. So descomente se o frontend nao
# estiver na porta padrao. Varias origens vao separadas por virgula.
# CORS_ORIGINS=http://localhost:3000
